{
  "name": "gpao-t5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPAO-T5 Original AI Operating System — local development build",
  "author": "YOON",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gpao-t5": "bin/gpao-t5.mjs"
  },
  "files": [
    "bin",
    "src",
    "vendor"
  ],
  "scripts": {
    "audit:compare-live": "python3 scripts/compare-live/compare_contract.py",
    "test": "node --test --test-concurrency=3",
