{
  "name": "gpao-t5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPAO-T5 Original AI Operating System — local development build",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gpao-t5": "bin/gpao-t5.mjs"
  },
  "files": [
    "bin",
    "src",
    "vendor"
  ],
  "scripts": {
    "audit:compare-live": "python3 scripts/compare-live/compare_contract.py",
    "test": "node --test --test-concurrency=3",
    "start": "node src/surface/server.js",
    "audit:workspace": "node scripts/audit-project-entry.mjs",
    "model:facts": "node scripts/model-connection-facts.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "refoundation:doctor": "node refoundation/scripts/doctor.mjs",
    "refoundation:boundary": "node refoundation/scripts/check-boundary.mjs",
    "refoundation:test": "node --test refoundation/test/*.test.js",
    "refoundation:check": "npm run refoundation:doctor && npm run refoundation:boundary && npm run refoundation:test",
    "refoundation:integration": "node --test refoundation/test/*.integration.js",
    "refoundation:ci": "npm run refoundation:check && npm run refoundation:integration",
    "refoundation:isolated": "node refoundation/scripts/run-isolated.mjs --",
    "refoundation:live": "node refoundation/scripts/run-live.mjs",
    "refoundation:connections": "node refoundation/scripts/list-connections.mjs",
    "refoundation:connect:oauth": "node refoundation/scripts/connect-chatgpt.mjs",
    "refoundation:evidence": "node refoundation/scripts/summarize-live-evidence.mjs",
    "refoundation:qualify:project": "node refoundation/scripts/run-project-qualification.mjs",
    "gate": "node scripts/gate.mjs",
    "live:charter": "node scripts/live/charter.mjs",
    "audit:docs": "node scripts/audit-docs.mjs",
    "audit:plan": "node scripts/audit-plan.mjs",
    "audit:mutation": "node scripts/audit-mutation.mjs",
    "p90-1:live-reseal": "node scripts/production90/p90-1-live-reseal.mjs",
    "human-use:prepare": "node scripts/human-use/prepare.mjs",
    "human-use:verify": "node scripts/human-use/verify-evidence.mjs",
    "preview:isolated": "GPAO_T5_DATA_DIR=/tmp/t5-preview-state GPAO_T5_HOME=/tmp/t5-preview-home node src/surface/server.js"
  }
}
