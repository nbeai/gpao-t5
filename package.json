{
  "name": "gpao-t5",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "GPAO-T5 Original AI Operating System — local development build",
  "author": "YOON",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gpao-t5": "refoundation/scripts/start-console.mjs"
  },
  "files": [
    "refoundation",
    "COPYRIGHT",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "npm run refoundation:ci",
    "start": "node refoundation/scripts/start-console.mjs",
    "verify:package": "npm run refoundation:verify:macos",
    "refoundation:doctor": "node refoundation/scripts/doctor.mjs",
    "refoundation:boundary": "node refoundation/scripts/check-boundary.mjs",
    "refoundation:test": "node --test --test-concurrency=1 refoundation/test/*.test.js",
    "refoundation:check": "npm run refoundation:doctor && npm run refoundation:boundary && npm run refoundation:test",
    "refoundation:integration": "node refoundation/scripts/run-product-integrations.mjs",
    "refoundation:integration:browser-live": "node --test --test-concurrency=1 refoundation/test/persistent-browser-live.integration.js",
    "refoundation:mutation": "node refoundation/scripts/run-core-mutation-smoke.mjs",
    "refoundation:ci": "npm run refoundation:check && npm run refoundation:integration && npm run refoundation:mutation",
    "refoundation:isolated": "node refoundation/scripts/run-isolated.mjs --",
    "refoundation:live": "node refoundation/scripts/run-live.mjs",
    "refoundation:connections": "node refoundation/scripts/list-connections.mjs",
    "refoundation:connect:oauth": "node refoundation/scripts/connect-chatgpt.mjs",
    "refoundation:evidence": "node refoundation/scripts/summarize-live-evidence.mjs",
    "refoundation:qualify:project": "node refoundation/scripts/run-project-qualification.mjs",
    "refoundation:qualify:terminal": "node refoundation/scripts/run-terminal-performance.mjs",
    "refoundation:qualify:terminal-human": "node refoundation/scripts/launch-terminal-core-human-console.mjs --human-controlled",
    "refoundation:baseline:documents": "node refoundation/scripts/run-document-compatibility-baseline.mjs",
    "refoundation:qualify:document-candidate": "node refoundation/scripts/run-document-candidate-qualification.mjs",
    "refoundation:qualify:document-connection": "node refoundation/scripts/run-qualified-document-connection.mjs",
    "refoundation:qualify:document-structure": "node refoundation/scripts/run-structural-document-qualification.mjs",
    "refoundation:qualify:deliverable-truth": "node refoundation/scripts/run-deliverable-truth-qualification.mjs",
    "refoundation:notices": "node refoundation/scripts/generate-third-party-notices.mjs",
    "refoundation:qualify:pdf-deliverable": "node refoundation/scripts/run-pdf-deliverable-qualification.mjs",
    "refoundation:qualify:text-tabular": "node refoundation/scripts/run-text-tabular-qualification.mjs",
    "refoundation:console": "node refoundation/scripts/start-console.mjs",
    "refoundation:audit:backend": "node refoundation/scripts/audit-backend-demand.mjs",
    "refoundation:compare:skills": "node refoundation/scripts/run-skill-value-comparison.mjs",
    "refoundation:compare:tool-projection": "node refoundation/scripts/run-tool-receipt-projection-comparison.mjs",
    "refoundation:compare:skill-catalog": "node refoundation/scripts/run-skill-catalog-comparison.mjs",
    "refoundation:qualify:context-pressure": "node refoundation/scripts/run-context-pressure-qualification.mjs",
    "refoundation:qualify:conversation-pressure": "node refoundation/scripts/run-conversation-pressure-qualification.mjs",
    "refoundation:qualify:checkpoint-continuity": "node refoundation/scripts/run-checkpoint-continuity-qualification.mjs",
    "refoundation:qualify:memory-flush": "node refoundation/scripts/run-memory-flush-qualification.mjs",
    "refoundation:qualify:memory-selection": "node refoundation/scripts/run-memory-selection-qualification.mjs",
    "refoundation:qualify:session-search": "node refoundation/scripts/run-session-search-qualification.mjs",
    "refoundation:qualify:recovery": "node refoundation/scripts/run-recovery-qualification.mjs",
    "refoundation:compare:recovery": "node refoundation/scripts/run-recovery-comparison.mjs",
    "refoundation:compare:interaction-core": "node refoundation/scripts/run-interaction-core-comparison.mjs",
    "refoundation:compare:interaction-tools": "node refoundation/scripts/run-interaction-core-tool-comparison.mjs",
    "refoundation:compare:interaction-long": "node refoundation/scripts/run-interaction-long-conversation.mjs",
    "refoundation:qualify:human-scenarios": "node refoundation/scripts/run-human-scenarios.mjs",
    "refoundation:qualify:business-human": "node refoundation/scripts/launch-s3-human-business-console.mjs --human-controlled",
    "refoundation:plan:business-human": "node refoundation/scripts/plan-s3-human-business-wave.mjs",
    "refoundation:observe:business-human": "node refoundation/scripts/manage-s3-human-business-observation.mjs",
    "refoundation:summarize:business-human": "node refoundation/scripts/summarize-s3-human-business-console.mjs",
    "refoundation:summarize:business-human-wave": "node refoundation/scripts/summarize-s3-human-business-wave.mjs",
    "refoundation:qualify:business-workflow": "node refoundation/scripts/run-business-workflow-qualification.mjs",
    "refoundation:summarize:business-continuity": "node refoundation/scripts/summarize-business-artifact-continuity.mjs",
    "refoundation:qualify:document-data": "node refoundation/scripts/run-document-data-qualification.mjs",
    "refoundation:qualify:attachments": "node refoundation/scripts/run-attachment-qualification.mjs",
    "refoundation:qualify:restart-hygiene": "node refoundation/scripts/run-incomplete-tool-restart-qualification.mjs",
    "refoundation:package:macos": "node refoundation/scripts/build-macos-installer.mjs",
    "refoundation:verify:macos": "node refoundation/scripts/verify-macos-installer.mjs",
    "preview:isolated": "T5_REFOUNDATION_CONSOLE_STATE=/tmp/t5-preview-state T5_REFOUNDATION_WORKSPACE=/tmp/t5-preview-home node refoundation/scripts/start-console.mjs"
  }
}
