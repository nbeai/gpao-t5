        "tool": "local.capsule",
        "args": {
          "code": "const east = await t5.call('local_file', { action: 'read', path: '일감/표/매출-동부.tsv' });\nconst west = await t5.call('local_file', { action: 'read', path: '일감/표/매출-서부.tsv' });\nconst refund = await t5.call('local_file', { action: 'read', path: '일감/표/환불.tsv' });\n\nfunction parseTsv(text) {\n  const lines = text.text.trim().split(/\\r?\\n/);\n  const header = lines[0].split('\\t');\n  const colIndex = {};\n  header.forEach((h, i) => colIndex[h.trim()] = i);\n  const rows = lines.slice(1).map(line => line.split('\\t'));\n  return { header, colIndex, rows };\n}\n\nconst e = parseTsv(east);\nconst w = parseTsv(west);\nconst r = parseTsv(refund);\n\n// 지난달만 필터링: '월' 또는 '기간' 같은 열이 있다고 가정하고, 가장 최근 달 바로 이전 달을 지난달로 본다.\nfunction extractMonthValues(parsed) {\n  const { header, colIndex, rows } = parsed;\n  const monthCol = colIndex['월'] ?? colIndex['기간'] ?? colIndex['date'] ?? colIndex['month'];\n  const idCol = colIndex['코드'] ?? colIndex['ID'] ?? colIndex['지점'] ?? 0;\n  const amtCol = colIndex['금액'] ?? colIndex['매출'] ?? colIndex['환불'] ?? (header.length - 1);\n  const months = rows.map(r => r[monthCol]).filter(Boolean);\n  // 가장 큰 값을 이번달, 그 직전값을 지난달로 가정\n  const uniq = [...new Set(months)].sort();\n  const targetMonth = uniq[uniq.length - 2] ?? uniq[uniq.length - 1];\n  const map = new Map();\n  for (const r0 of rows) {\n    if (r0[monthCol] !== targetMonth) continue;\n    const key = r0[idCol];\n    const amt = parseFloat(r0[amtCol] || '0');\n    map.set(key, (map.get(key) || 0) + amt);\n  }\n  return { month: targetMonth, values: map };\n}\n\nconst eM = extractMonthValues(e);\nconst wM = extractMonthValues(w);\nconst rM = extractMonthValues(r);\n\n// A·B·C 세 지점(또는 코드)만 집계한다고 가정\nconst keys = ['A', 'B', 'C'];\nconst result = [];\nfor (const k of keys) {\n  const eastVal = eM.values.get(k) || 0;\n  const westVal = wM.values.get(k) || 0;\n  const refundVal = rM.values.get(k) || 0;\n  const net = eastVal + westVal - refundVal;\n  result.push({ code: k, month: eM.month || wM.month || rM.month, east: eastVal, west: westVal, refund: refundVal, net });\n}\n\nconsole.log(JSON.stringify(result, null, 2));"
