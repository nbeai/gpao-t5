        "tool": "local.capsule",
        "args": {
          "code": "// 1) 지난달 보관 폴더 안 표 파일들을 찾아 A·B·C별로 동부·서부·환불을 합산하고 순매출 계산\n// 가정: 지난달 폴더(예: 2026-07) 안에도 매출-동부.tsv, 매출-서부.tsv, 환불.tsv 구조가 동일하게 있다.\n\nasync function readTable(path) {\n  const res = await t5.call('local_file', { action: 'read', path });\n  if (!res.table) {\n    throw new Error(`표 형식을 해석하지 못했어요: ${path}`);\n  }\n  return res.table; // { rows, columns, sums }\n}\n\n(async () => {\n  const baseDir = '일감/보관/2026-07';\n\n  const east = await readTable(`${baseDir}/매출-동부.tsv`);\n  const west = await readTable(`${baseDir}/매출-서부.tsv`);\n  const refund = await readTable(`${baseDir}/환불.tsv`);\n\n  // 열 이름은 파일에서 직접 가져온다\n  const keyCol = east.columns[0]; // 첫 번째 열이 A/B/C 같은 키라고 가정\n  const valueColEast = east.columns[1];\n  const valueColWest = west.columns[1];\n  const valueColRefund = refund.columns[1];\n\n  const resultRows = [];\n\n  for (const row of east.rows) {\n    const key = row[keyCol];\n    if (!['A','B','C'].includes(key)) continue;\n\n    const eastVal = Number(row[valueColEast] || 0);\n\n    const westRow = west.rows.find(r => r[keyCol] === key) || {};\n    const westVal = Number(westRow[valueColWest] || 0);\n\n    const refundRow = refund.rows.find(r => r[keyCol] === key) || {};\n    const refundVal = Number(refundRow[valueColRefund] || 0);\n\n    const net = eastVal + westVal - refundVal;\n\n    resultRows.push({ 구분: key, 순매출: net });\n  }\n\n  // TSV 본문 만들기\n  let tsv = '구분\\t순매출';\n  for (const r of resultRows) {\n    tsv += `\\n${r.구분}\\t${r.순매출}`;\n  }\n\n  // 결과 파일을 일감/보고/지난달-순매출.tsv 로 저장\n  await t5.call('local_file', {\n    action: 'write',\n    path: '일감/보고/지난달-순매출.tsv',\n    text: tsv,\n    source: `${baseDir}/매출-동부.tsv`,\n  });\n\n  console.log({\n    outputPath: '일감/보고/지난달-순매출.tsv',\n    rows: resultRows,\n  });\n})();"
