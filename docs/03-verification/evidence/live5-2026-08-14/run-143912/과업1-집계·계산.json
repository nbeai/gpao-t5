        "tool": "local.capsule",
        "args": {
          "code": "const logDir = \"<방>/home/일감/로그\";\n\n(async () => {\n  // 1) 로그 폴더 파일 목록\n  const listRes = await t5.call(\"local.file\", { action: \"list\", path: logDir });\n  const files = listRes.items || [];\n\n  const errorCounts = {};\n\n  // 2) 각 로그 파일을 읽어서 ERROR 코드별로 카운트\n  for (const f of files) {\n    if (f.kind !== \"file\") continue;\n    const readRes = await t5.call(\"local.file\", { action: \"read\", path: `${logDir}/${f.name}` });\n    const lines = readRes.text.split(/\\r?\\n/);\n    for (const line of lines) {\n      // 예: \"2026-08-13 10:00:00 ERROR E1001 Something happened\"\n      if (!line.includes(\"ERROR\")) continue;\n      const m = line.match(/ERROR\\s+([A-Z0-9_]+)/);\n      if (!m) continue;\n      const code = m[1];\n      errorCounts[code] = (errorCounts[code] || 0) + 1;\n    }\n  }\n\n  console.log({ errorCounts });\n})();"
        },
