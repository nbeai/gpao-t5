diff --git a/test/ux-history-load-interaction.test.js b/test/ux-history-load-interaction.test.js
new file mode 100644
index 00000000..7bd88fa9
--- /dev/null
+++ b/test/ux-history-load-interaction.test.js
@@ -0,0 +1,89 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+
+const execFileAsync = promisify(execFile);
+
+async function 실제크롬배치() {
+  const { stdout } = await execFileAsync(process.execPath, ['scripts/live/ux-history-load-fixture.mjs'], {
+    cwd: new URL('..', import.meta.url), timeout: 110_000, maxBuffer: 4 * 1024 * 1024,
+  });
+  return JSON.parse(stdout);
+}
+
+async function 종료반대시험() {
+  const { stdout } = await execFileAsync(process.execPath, ['scripts/live/ux-history-cdp-cleanup-proof.mjs'], {
+    cwd: new URL('..', import.meta.url), timeout: 25_000,
+  });
+  return JSON.parse(stdout);
+}
+
+function 증분근거(증거, 폭) {
+  assert.equal(증거.폭, 폭);
+  assert.equal(증거.변이, 'none');
+  assert.equal(증거.처음그린대화, 80, '처음에는 최근 80개만 보여야 한다');
+  const [휠, 좌표클릭] = 증거.증분로드;
+  assert.deepEqual([휠.그린대화, 좌표클릭.그린대화], [160, 240]);
+  assert.equal(휠.방법, '실제 CDP 마우스 휠 위로');
+  assert.equal(좌표클릭.방법, '보이는 버튼 CDP 좌표 클릭');
+  assert.deepEqual([휠.oldStart, 좌표클릭.oldStart], [160, 80]);
+  for (const load of [휠, 좌표클릭]) {
+    assert.ok(Number.isFinite(load.beforeY) && Number.isFinite(load.afterY) && Number.isFinite(load.delta));
+    assert.ok(Math.abs(load.delta) <= 0.75,
+      `${폭}px oldStart=${load.oldStart} 원문 자리가 ${load.delta}px 튀었다`);
+    assert.equal(load.uniqueCount, load.그린대화);
+    assert.equal(load.duplicates, 0, '증분 load가 이미 보이는 원문을 복제하면 안 된다');
+  }
+  assert.deepEqual(휠.indices, Array.from({ length: 160 }, (_, i) => i + 80));
+  assert.deepEqual(좌표클릭.indices, Array.from({ length: 240 }, (_, i) => i));
+  assert.equal(좌표클릭.button.viewportVisible, true, '화면 밖 버튼을 스크립트로 누르면 안 된다');
+  assert.equal(좌표클릭.input.method, 'Input.dispatchMouseEvent');
+  assert.equal(좌표클릭.input.coordinateClick, true);
+  assert.ok(좌표클릭.button.x >= 좌표클릭.button.left && 좌표클릭.button.x <= 좌표클릭.button.right);
+  assert.ok(좌표클릭.button.y >= 좌표클릭.button.top && 좌표클릭.button.y <= 좌표클릭.button.bottom);
+  assert.deepEqual(증거.경계검색.경계, { 수: 81, 더보기: false });
+  assert.deepEqual(증거.경계검색.작은대화, { 수: 20, 더보기: false });
+  assert.equal(증거.경계검색.접힌검색.대상번호, '20');
+  assert.equal(증거.경계검색.접힌검색.원문강조, '접힌 정확한 원문');
+  assert.ok(증거.경계검색.접힌검색.그린대화 > 80);
+  assert.deepEqual(증거.경계검색.부재후, 증거.경계검색.부재전,
+    '없는 검색 결과가 현재 대화와 로드 범위를 바꾸면 안 된다');
+  assert.equal(증거.경계검색.통과, true);
+  assert.equal(증거.전체통과, true);
+}
+
+// 한 격리 Chrome/프로필과 한 서버 안에서 두 viewport와 두 실제 제품 변이를 순차로 잰다.
+// 정적 HTML의 낱말을 세지 않고 실제 휠·화면 안 좌표 클릭 뒤의 DOM 원문과 동적 anchor를 읽는다.
+test('대화 이력 손을 한 실제 Chrome 배치에서 양성·반대시험까지 증명한다', { timeout: 120_000 }, async () => {
+  const evidence = await 실제크롬배치();
+  assert.equal(evidence.chromeLaunches, 1);
+  assert.equal(evidence.serverLaunches, 1);
+  assert.equal(evidence.profileCount, 1);
+  assert.deepEqual(evidence.양성.map((x) => x.폭), [1180, 375]);
+  evidence.양성.forEach((x) => 증분근거(x, x.폭));
+
+  assert.deepEqual(evidence.변이.map((x) => x.변이), [
+    'anchor-correction-removed', 'unique-guard-removed',
+  ]);
+  const [anchorRemoved, uniqueRemoved] = evidence.변이;
+  assert.equal(anchorRemoved.전체통과, false, 'anchor 보정 제거 변이가 초록으로 살아남았다');
+  assert.ok(anchorRemoved.증분로드.some((x) => Math.abs(x.delta) > 0.75));
+  assert.equal(uniqueRemoved.전체통과, false, '원문 고유성 제거 변이가 초록으로 살아남았다');
+  assert.ok(uniqueRemoved.증분로드.some((x) => x.duplicates > 0));
+  assert.equal(evidence.통과, true);
+
+  // 별도 파일로 두면 test-concurrency=3에서 실제 Chrome 둘이 겹친다. 같은 gate 한 줄에서
+  // 정상 배치가 닫힌 다음 실패 종료 세 갈래를 순차로 밟는다.
+  const cleanup = await 종료반대시험();
+  assert.deepEqual({ processes: cleanup.signal.processes, directory: cleanup.signal.directory }, {
+    processes: 0, directory: false,
+  });
+  assert.deepEqual({ message: cleanup.beforePort.message, processes: cleanup.beforePort.processes, directory: cleanup.beforePort.directory }, {
+    message: '시험용 포트 이전 실패', processes: 0, directory: false,
+  });
+  assert.deepEqual({ message: cleanup.beforeTarget.message, processes: cleanup.beforeTarget.processes, directory: cleanup.beforeTarget.directory }, {
+    message: '시험용 대상 탐색 이전 실패', processes: 0, directory: false,
+  });
+  assert.equal(cleanup.통과, true);
+});
