+test('RED: terminal 권위는 오류 문자열이 아니라 구조화 sandbox enforcement만 따른다', async () => {
+  const cwd = await mkdtemp(join(tmpdir(), 't5-terminal-enforcement-'));
+  for (const stderr of [
