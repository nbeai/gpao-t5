+const mainTools = (opts) => (opts?.tools ?? []).some((tool) => tool.name === 'local.terminal');
+
+for (const lane of ['계획', '걸음']) {
+  test(`${lane} 레인: direct write는 approval 0으로 닫고 같은 턴 stdout→local.file write/read로 복구한다`, async () => {
+    const root = await mkdtemp(join(tmpdir(), `t5-batch-${lane}-`));
+    const calls = [];
+    const terminal = makeLocalTerminalTool({ cwd: root, sandboxAvailable: () => true, async run(command, opts) {
+      calls.push({ command, mode: opts.mode });
+      if (command === 'opaque-direct-write') {
+        return { command, cwd: root, mode: opts.mode, exitCode: 1, stdout: '',
+          stderr: 'operation not permitted: opaque-output', processDelivery: 'delivered',
+          sandboxEnforcement: { state: 'enforced', policy: 'deny-external-effects' } };
+      }
+      if (command === 'opaque-stdout-compute') {
+        return { command, cwd: root, mode: opts.mode, exitCode: 0, stdout: 'name\tcount\na\t2\n',
+          stderr: '', processDelivery: 'delivered',
+          sandboxEnforcement: { state: 'enforced', policy: 'deny-external-effects' } };
+      }
+      throw new Error(`unexpected terminal command: ${command}`);
+    } });
+    const localFile = makeLocalFileTool({ roots: [root], homeDir: root, dataDir: root });
+    const ledgerEntries = [];
+    let step = 0;
+    const model = { async respond(_tc, opts = {}) {
+      if (!mainTools(opts)) return '완료';
+      step += 1;
+      if (lane === '걸음' && step === 1) {
+        return { text: '', toolCalls: [{ name: 'local.file', args: { action: 'list', path: root } }] };
+      }
+      const n = lane === '걸음' ? step - 1 : step;
+      if (n === 1) return { text: '', toolCalls: [{ name: 'local.terminal', args: { command: 'opaque-direct-write', cwd: root } }] };
+      if (n === 2) return { text: '', toolCalls: [{ name: 'local.terminal', args: { command: 'opaque-stdout-compute', cwd: root } }] };
+      if (n === 3) return { text: '', toolCalls: [{ name: 'local.file', args: { action: 'write', path: 'result.tsv', text: 'name\tcount\na\t2\n' } }] };
+      if (n === 4) return { text: '', toolCalls: [{ name: 'local.file', args: { action: 'read', path: 'result.tsv' } }] };
+      return '완료';
+    } };
+    const result = await runTurn({ text: '계산 결과를 result.tsv로 만들어 확인해줘' }, {
+      env: demoEnv(), model,
+      tools: demoTools({ localTerminal: terminal, localFile }),
+      pending: new Map(),
+      ledger: { entries: ledgerEntries, append(rec) { ledgerEntries.push(rec); return rec; } },
+    });
+
+    assert.notEqual(result.kind, 'approval', 'direct write 복구에 승인 카드가 생겼다');
+    assert.equal(calls.filter((call) => call.command === 'opaque-direct-write' && call.mode === 'granted').length, 0,
+      '원 direct-write 명령이 granted로 실행됐다');
+    assert.equal(calls.filter((call) => call.command === 'opaque-direct-write').length, 1,
+      '안전 probe 뒤 원 명령을 다시 실행했다');
+    assert.equal(await readFile(join(root, 'result.tsv'), 'utf8'), 'name\tcount\na\t2\n');
+    const terminalBlocked = ledgerEntries.find((rec) => rec.actualCall?.args?.command === 'opaque-direct-write');
+    assert.equal(terminalBlocked?.result?.processDelivery, 'delivered');
+    assert.equal(terminalBlocked?.result?.applied, false);
+    const write = ledgerEntries.find((rec) => rec.actualCall?.tool === 'local.file' && rec.actualCall?.args?.action === 'write');
+    const read = ledgerEntries.find((rec) => rec.actualCall?.tool === 'local.file' && rec.actualCall?.args?.action === 'read');
+    assert.equal(write?.failureState, 'none');
+    assert.equal(write?.result?.readbackExact, true);
+    assert.equal(read?.result?.text, 'name\tcount\na\t2\n');
+  });
+}
