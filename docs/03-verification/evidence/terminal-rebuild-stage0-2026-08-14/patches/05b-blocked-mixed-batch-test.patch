+  ]) {
+    let replays = 0;
+    const tool = makeLocalTerminalTool({ cwd, sandboxAvailable: () => true, run: async () => {
+      replays += 1;
+      throw new Error('sandbox probe must never be replayed as granted');
+    } });
+    const probeResult = enforcedProbe('opaque-command', cwd, stderr);
+    const out = await tool.handler({ command: 'opaque-command', cwd, probeResult }, {
+      selfState: buildSelfState(demoEnv()),
+    });
+    assert.equal(replays, 0);
+    assert.equal(out.failed, true);
+    assert.equal(out.needsGrant, undefined);
+    assert.equal(out.failureResult.processDelivery, 'delivered');
+    assert.equal(out.failureResult.exitCode, 1);
+    assert.equal(out.failureResult.stderr, stderr);
+    assert.deepEqual(out.failureResult.effects, {
