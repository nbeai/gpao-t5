+async function atomicDebris(root) {
+  const found = [];
+  async function walk(dir) {
+    for (const entry of await readdir(dir, { withFileTypes: true }).catch(() => [])) {
+      const path = join(dir, entry.name);
+      if (entry.isDirectory()) await walk(path);
+      else if (/\.t5-.*\.tmp$/.test(entry.name) || (dir.endsWith('/.trash') && !entry.name.endsWith('undo-log.json'))) found.push(path);
+    }
+  }
+  await walk(root);
+  return found;
+}
+
+for (const failure of ['temp-write', 'commit', 'readback', 'undo-log']) {
+  test(`atomic ${failure} 실패는 기존 원본을 즉시 복원하고 temp·거짓 성공을 남기지 않는다`, async () => {
+    const root = await mkdtemp(join(tmpdir(), `t5-atomic-${failure}-`));
+    const path = join(root, 'result.txt');
+    await writeFile(path, 'original');
+    const deps = { roots: [root], homeDir: root, dataDir: root };
+    if (failure === 'temp-write') deps.atomicWriteFile = async () => { throw new Error('injected temp write failure'); };
+    if (failure === 'commit') deps.atomicRename = async () => { throw new Error('injected commit failure'); };
+    if (failure === 'readback') deps.afterAtomicCommit = async ({ path: target }) => { await writeFile(target, 'corrupt'); };
+    if (failure === 'undo-log') deps.beforeUndoLog = async () => { throw new Error('injected undo log failure'); };
+    const tool = makeLocalFileTool(deps);
+
+    const out = await tool.handler({ action: 'write', path: 'result.txt', text: 'replacement' });
+    assert.equal(out.blocked, true, `실패를 성공으로 냈다: ${JSON.stringify(out)}`);
+    assert.equal(await readFile(path, 'utf8'), 'original');
+    assert.deepEqual(await atomicDebris(root), [], '실패 뒤 temp/고아 backup이 남았다');
+  });
+}
