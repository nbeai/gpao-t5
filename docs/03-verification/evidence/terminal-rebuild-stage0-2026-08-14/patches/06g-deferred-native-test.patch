+import { fileURLToPath } from 'node:url';
+
+import {
+  FileBrokerClient,
+  FileBrokerUnavailableError,
+  fileBrokerPlatformSupported,
+} from '../src/runtime/file-broker-client.js';
+
+const run = promisify(execFile);
+const repo = fileURLToPath(new URL('..', import.meta.url));
+let binaryPath;
+
+before(async () => {
+  if (process.platform !== 'darwin' || process.arch !== 'arm64') return;
+  const out = await mkdtemp(join(tmpdir(), 't5-file-broker-bin-'));
+  binaryPath = join(out, 't5-file-broker');
+  await run('xcrun', [
+    'clang', '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror',
+    '-DT5_BROKER_TESTING=1',
+    '-mmacosx-version-min=13.0',
+    join(repo, 'src/native/file-broker/file-broker.c'), '-o', binaryPath,
+  ]);
+});
+
+async function fixture({ stateMode = 0o700 } = {}) {
+  const base = await mkdtemp(join(tmpdir(), 't5-file-broker-test-'));
+  const root = join(base, 'root');
+  const state = join(base, 'state');
+  await mkdir(root);
+  await mkdir(state, { mode: stateMode });
+  await chmod(state, stateMode);
+  return { base, root, state };
+}
+
+async function open(f) {
+  return FileBrokerClient.open({ rootDir: f.root, stateDir: f.state, binaryPath, testing: f.testing });
+}
+
+async function waitFor(path, timeoutMs = 5_000) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    try { await stat(path); return; } catch (error) { if (error?.code !== 'ENOENT') throw error; }
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+  throw new Error(`timed out waiting for ${path}`);
+}
+
+async function releasePause(stateDir, stage) {
+  await writeFile(join(stateDir, `.t5fb-test-${stage}.resume`), 'resume');
+}
+
+test('native file broker test suite has its exact supported host', { skip: process.platform === 'darwin' && process.arch === 'arm64' ? false : 'darwin-arm64 only' }, () => {
+  assert.equal(process.platform, 'darwin');
+  assert.equal(process.arch, 'arm64');
+});
+
+test('PUT is root-relative, creates parents, preserves bytes, and returns a durable explicit undo ref', { skip: process.platform !== 'darwin' || process.arch !== 'arm64' }, async (t) => {
+  const f = await fixture();
+  t.after(() => rm(f.base, { recursive: true, force: true }));
+  const client = await open(f);
+  t.after(() => client.close());
+
+  const bytes = Buffer.from([0, 1, 2, 10, 255, 0, 65]);
+  const put = await client.put({ path: 'nested/result.bin', data: bytes });
+  assert.match(put.undoRef, /^u1\.[a-f0-9]{32}$/);
+  assert.deepEqual(await readFile(join(f.root, 'nested/result.bin')), bytes);
+  assert.equal(put.readbackExact, true);
+  assert.equal((await stat(join(f.root, 'nested/result.bin'))).isFile(), true);
+
+  await client.close();
+  const reopened = await open(f);
+  t.after(() => reopened.close());
+  const recovered = await reopened.recover();
+  assert.ok(recovered.undoRefs.includes(put.undoRef));
+  const undone = await reopened.undoRef(put.undoRef);
+  assert.equal(undone.undone, true);
+  await assert.rejects(readFile(join(f.root, 'nested/result.bin')), { code: 'ENOENT' });
+});
