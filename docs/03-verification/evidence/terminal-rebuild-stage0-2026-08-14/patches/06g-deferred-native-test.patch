+test('overwrite UNDO restores mode, owner, timestamps, and extended attributes with old bytes', { skip: process.platform !== 'darwin' || process.arch !== 'arm64' }, async (t) => {
+  const f = await fixture();
+  t.after(() => rm(f.base, { recursive: true, force: true }));
+  const target = join(f.root, 'tool.sh');
+  await writeFile(target, '#!/bin/sh\necho old\n');
+  await chmod(target, 0o755);
+  const oldTime = new Date('2024-01-02T03:04:05.000Z');
+  await utimes(target, oldTime, oldTime);
+  await run('xattr', ['-w', 'com.gpao.t5.file-broker-test', 'kept-xattr', target]);
+  await run('chflags', ['hidden', target]);
+  const before = await stat(target);
+  const beforeFlags = (await run('stat', ['-f', '%Sf', target])).stdout.trim();
+  const client = await open(f);
+  t.after(() => client.close());
+  const put = await client.put({ path: 'tool.sh', data: Buffer.from('new') });
+  await client.undoRef(put.undoRef);
+  const after = await stat(target);
+  assert.equal(after.mode & 0o777, before.mode & 0o777);
+  assert.equal(after.uid, before.uid);
+  assert.equal(after.gid, before.gid);
+  assert.equal(after.mtimeMs, before.mtimeMs);
+  assert.equal((await run('stat', ['-f', '%Sf', target])).stdout.trim(), beforeFlags);
+  assert.equal((await run('xattr', ['-p', 'com.gpao.t5.file-broker-test', target])).stdout.trim(), 'kept-xattr');
