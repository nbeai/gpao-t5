+  const client = await open(f);
+  t.after(() => client.close());
+
+  const first = await client.put({ path: 'report.txt', data: Buffer.from('new\0bytes') });
+  assert.deepEqual(await readFile(join(f.root, 'report.txt')), Buffer.from('new\0bytes'));
+  await client.undoRef(first.undoRef);
+  assert.deepEqual(await readFile(join(f.root, 'report.txt')), Buffer.from('old\0bytes'));
+
+  const second = await client.put({ path: 'report.txt', data: Buffer.from('broker-value') });
+  await writeFile(join(f.root, 'report.txt'), 'later-writer');
+  await assert.rejects(client.undoRef(second.undoRef), (error) => error?.code === 'TARGET_CHANGED');
+  assert.equal(await readFile(join(f.root, 'report.txt'), 'utf8'), 'later-writer');
+});
