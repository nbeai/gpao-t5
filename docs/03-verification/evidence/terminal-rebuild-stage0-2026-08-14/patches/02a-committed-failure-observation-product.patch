+    assert.equal(failed.failureState, 'failed');
+    assert.equal(failed.result, undefined, '지속 원장에 같은 턴 전용 실패 관측이 남았다');
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
