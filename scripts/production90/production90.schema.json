{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t5-production90",
  "title": "T5 Production 90 Wave 0 contracts",
  "$ref": "#/$defs/runBundle",
  "$defs": {
    "status": {
      "enum": ["PASS", "PRODUCT_FAIL", "MODEL_FAIL", "EXTERNAL_BLOCKED", "HARNESS_INVALID", "NOT_RUN"]
    },
    "metric": {
      "type": "object",
      "required": ["id", "factKey", "kind", "denominator", "passRule", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "factKey": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "kind": {"enum": ["deterministic", "variable", "human"]},
        "denominator": {
          "type": "object",
          "required": ["unit", "planned"],
          "properties": {"unit": {"type": "string"}, "planned": {"type": "integer", "minimum": 1}}
        },
        "passRule": {
          "type": "object",
          "required": ["target"],
          "properties": {"target": {"type": "number", "minimum": 0, "maximum": 1}}
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hardGate": {"enum": ["P0", "P1"]}
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "title", "kind", "metrics", "denominator", "environment", "authority", "privacy", "failurePolicy"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "kind": {"enum": ["deterministic", "variable", "human"]},
        "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "denominator": {"type": "object", "required": ["unit", "planned"]},
        "environment": {"type": "object", "required": ["artifact"]},
        "authority": {"type": "object", "required": ["externalEffects"]},
        "privacy": {"type": "object", "required": ["rawSecrets"], "properties": {"rawSecrets": {"const": false}}},
        "failurePolicy": {"type": "object", "required": ["providerError"]},
        "steps": {"type": "array"}, "observations": {"type": "array"}
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "modelReceipt": {
      "type": "object",
      "required": ["provider", "model", "receiptDigest"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "receiptDigest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "runResult": {
      "type": "object",
      "required": ["runId", "scenarioId", "scenarioSampleIndex", "manifestDigest", "buildDigest", "environmentDigest", "modelReceipt", "results"],
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "scenarioId": {"type": "string", "minLength": 1},
        "scenarioSampleIndex": {"type": "integer", "minimum": 1},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "buildDigest": {"$ref": "#/$defs/digest"},
        "environmentDigest": {"$ref": "#/$defs/digest"},
        "modelReceipt": {"oneOf": [{"$ref": "#/$defs/modelReceipt"}, {"type": "null"}]},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "required": ["metricId", "sampleIndex", "status", "evidenceRefs"],
            "properties": {
              "metricId": {"type": "string", "minLength": 1},
              "sampleIndex": {"type": "integer", "minimum": 1},
              "status": {"$ref": "#/$defs/status"},
              "p0": {"type": "boolean"},
              "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runBundle": {
      "type": "object",
      "required": ["schemaVersion", "manifestDigest", "buildDigest", "runs"],
      "properties": {
        "schemaVersion": {"const": 1},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "buildDigest": {"$ref": "#/$defs/digest"},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/runResult"}}
      },
      "additionalProperties": false
    }
  }
}
