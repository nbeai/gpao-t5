        { "guidePath": "package/README.txt", "targetPath": "package/실행.command" }
      ],
      "entrypoint": {
        "id": "mac-launcher",
        "platform": "darwin",
        "interpreter": "/bin/zsh",
        "path": "package/실행.command",
        "cwd": "package",
        "requiresExecutablePermission": true,
        "stdin": "\n",
        "expectedExitCode": 0,
        "expectedStdoutIncludes": ["ITEMS=4 NEEDS_ORDER=2"]
      },
      "expectedQualification": "failed"
    },
