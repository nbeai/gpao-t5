        "package/실행.command": "#!/bin/zsh\ncd \"$(dirname \"$0\")\"\necho \"작은가게 재고 알림을 실행합니다...\"\n/usr/bin/env node app.js\nstatus=$?\necho\necho \"창을 닫으려면 Return 키를 누르세요.\"\nread -r\nexit $status\n"
      },
      "expectedFiles": ["package/app.js", "package/README.txt", "package/실행.command"],
