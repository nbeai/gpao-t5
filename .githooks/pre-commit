#!/bin/sh
# GPAO-T5 pre-commit — 빠른 것만(밀리초). 전체 테스트는 CI 가 돌린다(환경헌장).
# 설치: git config core.hooksPath .githooks
#
# ⚠️ 이 파일은 **본 worktree 의 체크아웃**에서 돈다. `core.hooksPath` 가 절대경로라
#    연결 worktree 에서 이 파일을 고쳐도, 본 worktree 가 그 가지를 받기 전에는 안 문다.
#    `test/lane-guard-one-hand-per-room.test.js` 방⑤ 가 그 사실을 매번 대조한다.

# ── ① 방 하나에 손 하나 (F-100 · 오너 지시 2026-08-12 "방 나눠 · 구조로 박아") ──────
#
# 밟은 것: 손 A 가 `git merge --no-commit` 으로 창을 열고 그 사이 `npm test`(50초)를 돌렸다.
# 그 창에서 손 B 가 자기 문서를 커밋했고, **git 은 MERGE_HEAD 가 있으면 그 커밋을 병합
# 커밋으로 만든다.** 조각 A 병합이 「장부·지도·계획서: F-95 등재…」라는 **남의 제목**으로
# 닫혔다(885c363 부모 둘).
#
# **왜 착수 점검으로 못 막나**: 창은 열렸다 닫힌다. 손 B 가 그때 MERGE_HEAD 를 봤는데
# 없었다. 그리고 손 B 의 방어 둘을 이 창이 껐다 —
#   `git commit -- <경로>`      → fatal: cannot do a partial commit during a merge (두 번 다)
#   색인에서 내 경로 내리기       → 소용없다. 흡수는 색인이 아니라 MERGE_HEAD 로 일어난다
# **무는 자리는 커밋 그 순간뿐이다.**
#
# 무는 것은 딱 하나다(그물을 안 넓힌다): *MERGE_HEAD 가 섰는데 병합을 연 손이 아닌 커밋.*
# 평범한 단독 커밋에는 마찰이 0 이다 — 카드가 느는 변경은 개선이 아니라 실패다(§3.1).
gitdir=$(git rev-parse --git-dir 2>/dev/null || echo .git)
if [ -e "$gitdir/MERGE_HEAD" ] && [ -z "$GPAO_T5_MERGE_OWNER" ]; then
  echo "pre-commit 거부: 이 저장소에 **병합 창(MERGE_HEAD)이 열려 있습니다.**" >&2
  echo "  지금 커밋하면 그 커밋이 **남이 연 병합의 병합 커밋**이 됩니다(2026-08-12 실제 사고)." >&2
  echo "" >&2
  echo "  · 병합을 연 손이라면:  GPAO_T5_MERGE_OWNER=1 git commit …" >&2
  echo "  · 아니라면 이 방은 지금 남이 쓰는 중입니다 — **자기 worktree 에서 일하세요**:" >&2
  echo "      node scripts/lane.mjs <이름>" >&2
  echo "" >&2
  echo "  근거: 장부 F-100 · AGENTS.md \"isolate by git worktree; do not co-edit one file\"" >&2
  exit 1
fi

# ── ② 산출물·시크릿·스테이지가 staged 에 섞였는가 (환경헌장) ─────────────────────
#
# ⚠️ `-c core.quotepath=false` — 없으면 **한글 이름이 든 경로가 통째로 빠져나간다.**
# git 은 기본으로 비ASCII 경로를 `"dist/\353\262\210\353\223\244.js"` 처럼 따옴표로 감싸
# 내보내고, 그러면 `(^|/)dist/` 의 `^` 앵커가 그 따옴표에 막힌다(재현 2026-08-12).
# 이 저장소가 같은 표기 매듭에 이미 두 번 데었다(locate 볼륨 이름 · 거짓말 탐지기 NFC).
staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

bad=$(printf '%s\n' "$staged" | grep -E '(^|/)(dist|build|out|node_modules|coverage)/|\.stage-|(^|/)\.env$|\.(pem|key|p12|pfx|jks|keystore)$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit 거부: 산출물/시크릿/스테이지 패턴이 staged 에 있습니다:" >&2
  printf '  %s\n' "$bad" >&2
  echo "환경헌장: 소스와 산출물은 물리적으로 분리, 시크릿은 커밋 금지." >&2
  exit 1
fi
exit 0
